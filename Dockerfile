FROM node:24-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ffmpeg ca-certificates openssl && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
RUN printf '%s\n' 'alembic==1.20.0' 'annotated-doc==0.0.5' 'annotated-types==0.8.0' 'anyio==4.15.1' 'certifi==2026.7.22' 'click==8.5.0' 'fastapi==0.141.1' 'greenlet==3.5.6' 'h11==0.16.0' 'httpcore==1.0.9' 'httpx==0.28.1' 'idna==3.20' 'Mako==1.4.1' 'MarkupSafe==3.0.3' 'packaging==26.3' 'pillow==12.3.0' 'psycopg==3.3.5' 'psycopg-binary==3.3.5' 'pydantic==2.13.5' 'pydantic_core==2.46.5' 'python-multipart==0.0.32' 'SQLAlchemy==2.0.54' 'starlette==1.6.0' 'typing-inspection==0.4.4' 'typing_extensions==4.16.0' 'uvicorn==0.53.0' > /tmp/requirements.txt && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt
RUN mkdir -p /opt/frontend-deps && printf '%s' '{"name":"semiocore-studio","version":"0.1.0","description":"","main":"index.js","scripts":{"dev":"vite --host 127.0.0.1","build":"tsc --noEmit && vite build","preview":"vite preview --host 127.0.0.1"},"keywords":[],"author":"","license":"ISC","type":"module","dependencies":{"lucide-react":"^1.47.0","react":"^19.3.0","react-dom":"^19.3.0"},"devDependencies":{"@types/node":"^26.6.1","@types/react":"^19.3.0","@types/react-dom":"^19.3.0","typescript":"^7.0.2","vite":"^8.3.0"},"private":true}' > /opt/frontend-deps/package.json && cd /opt/frontend-deps && npm install --no-audit --no-fund
RUN mkdir -p /opt/semio && : > /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN printf '%s' '' >> /opt/semio/runtime.b64
RUN base64 -d /opt/semio/runtime.b64 > /opt/semio/runtime.enc && rm /opt/semio/runtime.b64
RUN printf '%s\n' '#!/bin/sh' 'set -eu' ': "${SEMIOCORE_BUNDLE_KEY:?SEMIOCORE_BUNDLE_KEY nao configurada}"' ': "${DATABASE_URL:?DATABASE_URL nao configurada}"' ': "${ADMIN_EMAIL:?ADMIN_EMAIL nao configurado}"' ': "${ADMIN_PASSWORD:?ADMIN_PASSWORD nao configurada}"' 'rm -rf /app' 'mkdir -p /app' 'openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -in /opt/semio/runtime.enc -out /tmp/runtime.tar.gz -pass env:SEMIOCORE_BUNDLE_KEY' 'tar -xzf /tmp/runtime.tar.gz -C /app' 'rm -f /tmp/runtime.tar.gz' 'cp -a /opt/frontend-deps/node_modules /app/frontend/node_modules' 'cd /app/frontend' 'npm run build' 'rm -rf node_modules' 'export MEDIA_ROOT="${MEDIA_ROOT:-/app/media}"' 'mkdir -p "$MEDIA_ROOT"' 'cd /app/backend' '/opt/venv/bin/alembic upgrade head' '/opt/venv/bin/python -m semio.cli import' 'exec /opt/venv/bin/uvicorn semio.main:app --host 0.0.0.0 --port "${PORT:-8000}"' > /usr/local/bin/start-semiocore && chmod +x /usr/local/bin/start-semiocore
EXPOSE 8000
CMD ["/usr/local/bin/start-semiocore"]
